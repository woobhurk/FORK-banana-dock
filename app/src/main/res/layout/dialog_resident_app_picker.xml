<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:accessibilityPaneTitle="选择要添加的应用"
    android:orientation="vertical"
    android:paddingTop="16dp"
    android:paddingBottom="10dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:includeFontPadding="false"
        android:text="选择要添加的应用"
        android:textColor="@color/settings_text"
        android:textSize="20sp"
        android:textStyle="bold" />

    <FrameLayout
        android:id="@+id/residentPickerLists"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        android:layout_weight="1" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/settings_outline" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:includeFontPadding="false"
            android:text="带勾的应用已在黑名单中"
            android:textColor="@color/settings_secondary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/residentPickerCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_settings_secondary_button"
            android:minWidth="64dp"
            android:minHeight="48dp"
            android:text="取消"
            android:textColor="@color/settings_text"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
