<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/settings_ripple">
    <item>
        <selector>
            <item android:state_checked="true" android:drawable="@drawable/bg_settings_choice_selected" />
            <item android:state_selected="true" android:drawable="@drawable/bg_settings_choice_selected" />
            <item>
                <shape>
                    <solid android:color="@color/settings_nav" />
                    <stroke android:width="1dp" android:color="@color/settings_outline" />
                    <corners android:radius="8dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
