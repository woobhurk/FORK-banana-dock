<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#24FFFFFF">
    <item>
        <selector>
            <item android:state_activated="true">
                <shape>
                    <solid android:color="#2A4261" />
                    <stroke android:width="1dp" android:color="#719AD1" />
                    <corners android:radius="?attr/surfaceFieldRadius" />
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="#202E40" />
                    <stroke android:width="1dp" android:color="#48596E" />
                    <corners android:radius="?attr/surfaceFieldRadius" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
