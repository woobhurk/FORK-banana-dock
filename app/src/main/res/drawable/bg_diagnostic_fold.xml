<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/settings_ripple">
    <item>
        <selector>
            <item android:state_activated="true">
                <shape>
                    <solid android:color="@color/settings_nav_selected" />
                    <stroke android:width="1dp" android:color="@color/settings_accent" />
                    <corners android:radius="?attr/surfaceFieldRadius" />
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="@color/settings_field" />
                    <stroke android:width="1dp" android:color="@color/settings_outline" />
                    <corners android:radius="?attr/surfaceFieldRadius" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
